# Instruversal - Supabase Client Configuration
# Copy this file to .env.local and replace with your Supabase project credentials.
# Only publishable anonymous keys should be placed here.
# NEVER put service_role or secret keys in client-side code!

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key-here
